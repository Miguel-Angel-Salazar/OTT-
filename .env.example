# ============================================================
# Variables de Entorno - Plataforma OTT (MUBI Clone)
# ============================================================

# Base de Datos PostgreSQL
POSTGRES_USER=ott_user
POSTGRES_PASSWORD=ott_password
POSTGRES_DB=ott_db
POSTGRES_PORT=5432

# Backend Flask
DATABASE_URL=postgresql://ott_user:ott_password@db:5432/ott_db
SECRET_KEY=super_secret_mubi_ott_key_change_me
BACKEND_PORT=5000

# Frontend Nginx (Reverse Proxy & Static Asset Server)
FRONTEND_PORT=80
BACKEND_URL=http://backend:5000
